{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/server.js": {
      "includeFiles": "platforms.json",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/server?__tokkoPath="
    },
    {
      "source": "/api/:path*",
      "destination": "/api/server?__tokkoPath=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
