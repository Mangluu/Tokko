# Core runtime
PORT=3456
BASE_URL=http://localhost:3456
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PGPOOL_MAX=5

# Clerk website authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_M2M_TOKEN=
CLERK_AUTHORIZED_PARTIES=http://localhost:3456

# Service-to-service access (comma-separated keys)
EXTERNAL_API_KEYS=
HERMES_ACTION_SECRET=
UCP_SELECTION_SECRET=

# Hermes model configuration
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_API_KEY=

# Prava tokenized cards and mandates
PRAVA_API_BASE_URL=
PRAVA_PUBLISHABLE_KEY=
PRAVA_SECRET_KEY=
PRAVA_CARD_ENROLLMENT_AMOUNT=1
PRAVA_CARD_ENROLLMENT_CURRENCY=INR
PRAVA_MANDATE_CURRENCY=INR
PRAVA_MERCHANT_NAME=Tokko
PRAVA_MERCHANT_URL=http://localhost:3456
PRAVA_MERCHANT_COUNTRY_CODE=IN
PRAVA_ZEPTO_MERCHANT_NAME=Zepto
PRAVA_ZEPTO_MERCHANT_URL=https://www.zeptonow.com
PRAVA_ZEPTO_MERCHANT_COUNTRY_CODE=IN

# LINQ and messaging adapters
LINQ_API_BASE_URL=
LINQ_API_KEY=
LINQ_PHONE_NUMBER=
LINQ_PHONE_NUMBER_ID=
LINQ_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_FAMILY_EMAIL=

# Merchant and catalogue integrations
ZEPTO_OAUTH_CLIENT_ID=
UCP_AGENT_PROFILE_URL=
PLANTRI_API_KEY=

# Optional address geocoding
ADDRESS_GEOCODING_URL=https://nominatim.openstreetmap.org/search
